# Contact form (public key, safe to expose in the client bundle)
VITE_WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key

# Chatbot. Server-side only: read by api/chat.ts, never shipped to the browser.
# Set this in Vercel > Project > Settings > Environment Variables.
# (VITE_GEMINI_API_KEY is also accepted for backwards compatibility.)
GEMINI_API_KEY=replace_with_your_gemini_api_key
